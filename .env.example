# ── pick ONE auth path ──────────────────────────────────────────────
# A · Cloud Shell / Vertex via ADC (no keys — the codelab default):
STUDIO_VERTEX=1

# B · laptop / AI Studio key (comment A, uncomment B):
# GOOGLE_API_KEY=AIza…your-key…

# ── the room's shared platform (values come from your instructor) ──
# Fill these during Setup and every Finish also premieres to the room,
# silently. Leave them blank and everything still works, local only.
# VIBETUBE_URL=https://vibetube.dev          # the live platform (the instructor confirms the room code)
# VIBETUBE_EVENT=sandbox
# VIBETUBE_NAME=Your Name

# ── knobs you rarely touch ──────────────────────────────────────────
# STUDIO_REAL_VIDEO=0             # prebaked render farm: no Veo, no cost, 14-second waits
# STUDIO_VEO_MODEL=veo-3.1-fast-generate-preview
# STUDIO_VEO_LOCATION=us-central1   # Veo is regional (Gemini uses the global endpoint)
# STUDIO_DEADLINE_S=420           # how long the finish worker waits for a shot (14 when prebaked)
# STUDIO_DATASET=vibestudio
# STUDIO_MODEL=gemini-2.5-flash
# STUDIO_NO_BQ=1     # degrade graph readings honestly (no GCP project)
# STUDIO_NO_MB=1     # degrade memory honestly (no Agent Engine)
